[System]
Name: Concurrency

[Parameter]
p0 (int) : 0, 1
p1 (int) : 0, 1
p2 (int) : 0, 1
p3 (int) : 0, 1
p4 (int) : 0, 1

[Constraint]
(p2 != 0) || (p1 != 0) || (p4 != 1) || (p3 != 1) || (p0 != 0)
(p0 != 1) || (p4 != 0)
(p1 != 0) || (p4 != 1) || (p3 != 0) || (p2 != 1) || (p0 != 0)
(p4 != 0) || (p1 != 1)
(p3 != 1) || (p2 != 1) || (p0 != 0)
(p3 != 0) || (p0 != 1)
(p2 != 0) || (p3 != 0)
